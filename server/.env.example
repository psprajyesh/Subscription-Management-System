# ---------------------------------------------------------------------------
# Brightloop API — environment configuration
# Copy this file to `.env` and replace every placeholder value.
# Never commit `.env` or real credentials.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Local MongoDB (Atlas-ready: replace with your mongodb+srv:// connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/brightloop

# Frontend origin allowed by CORS (Vite dev server)
CLIENT_URL=http://localhost:5173

# Use secure cookies only when served over HTTPS (set to true in production)
COOKIE_SECURE=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=replace-with-a-long-random-string
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Password hashing cost (bcrypt). 12 is recommended; tests may lower it.
BCRYPT_ROUNDS=12

# Invoice settings
INVOICE_PREFIX=INV
INVOICE_DUE_DAYS=7

# Razorpay (test mode keys; leave blank until payment integration is configured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Development seed account (used by `npm run seed`)
SEED_ADMIN_NAME=Alex Davis
SEED_ADMIN_EMAIL=admin@brightloop.test
SEED_ADMIN_PASSWORD=change-me-before-seeding
